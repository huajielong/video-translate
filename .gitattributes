# Repository line-ending policy for the video-translate skill.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.wav binary
*.mp3 binary
*.m4a binary
*.mp4 binary
*.mkv binary
*.png binary
*.jpg binary
*.ttf binary
*.onnx binary
*.pt binary
*.pth binary
*.safetensors binary
