+def _pin_daemon(api: str) -> None:
+    """Pin the real daemon to P-cores and High priority.
+
+    The uv launcher means the PID returned by Popen is not the process that
+    runs GPT decode; the /health daemon.pid is.  On this laptop the decode
+    thread otherwise migrates to an E-core and RTF jumps from ~2 to ~7.
+    """
+    global _PINNED_PID, _PIN_CHECK
+    if os.name != "nt" or os.environ.get("VTV_PIN_DAEMON", "1") in (
+            "0", "false", "False", ""):
+        return
+    _PIN_CHECK += 1
+    if _PINNED_PID is not None and _PIN_CHECK % 5 != 0:
+        return
+    try:
+        with urllib.request.urlopen(f"{api}/health", timeout=5) as resp:
+            health = json.loads(resp.read().decode("utf-8"))
+        pid = int((health.get("daemon") or {}).get("pid") or 0)
+        if not pid or pid == _PINNED_PID:
+            return
+        handle = ctypes.windll.kernel32.OpenProcess(0x0200 | 0x0400, False, pid)
+        if handle:
+            ctypes.windll.kernel32.SetPriorityClass(handle, 0x00000080)  # HIGH
+            ctypes.windll.kernel32.SetProcessAffinityMask(handle, 0xFFFF)  # P-cores
+            ctypes.windll.kernel32.CloseHandle(handle)
+            _PINNED_PID = pid
+    except Exception:  # noqa: BLE001
+        pass
+
