+    def ratio(group: dict, slot_ms: int) -> float:
+        # Merge decisions use the fixed-overhead model, not cached durations:
+        # old per-line audio was synthesized without the merge, and using it
+        # here made the worst-first pass leave isolated short fragments.
+        return pred(group["chars"]) * 1000.0 / max(1, slot_ms)
+
+    merges = 0
+    while True:
+        best = None
