+def _fit_glossary_terms() -> list[tuple[str, list[str]]]:
+    path = os.environ.get("VTV_GLOSSARY_FILE") or f"{ROOT_DIR}/videotrans/glossary.txt"
+    terms: list[tuple[str, list[str]]] = []
+    try:
+        for line in Path(path).read_text(encoding="utf-8-sig", errors="replace").splitlines():
+            line = line.strip()
+            if not line or "=" not in line:
+                continue
+            src, tgt = line.split("=", 1)
+            variants = [re.sub(r"\s+", "", v) for v in tgt.split("|") if v.strip()]
+            if variants:
+                terms.append((src.strip(), variants))
+    except Exception:
+        pass
+    return terms
