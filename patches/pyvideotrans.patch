+            "end": b["end"],
+            "startraw": a["startraw"],
+            "endraw": b["endraw"],
+            "ref": a["ref"],
+            "role": a["role"],
+            "rate": a["rate"],
+            "volume": a["volume"],
+            "pitch": a["pitch"],
+            "tts_type": a["tts_type"],
+            "actual": 0,
+            "fixed": a["fixed"] or b["fixed"],
+            "items": a["items"] + b["items"],
