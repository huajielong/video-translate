+_ONE_LINE_BREAK = set("，,、；;：:。！？.!?…")
+
+
+def _split_one_line(text: str, limit: int) -> list[str]:
+    """Split text into one-line display cues at punctuation/space."""
+    text = re.sub(r"\s+", " ", (text or "")).strip()
+    if not text:
+        return []
+    if len(text) <= limit:
+        return [text]
+    out: list[str] = []
+    rest = text
+    while len(rest) > limit:
+        window = rest[:limit + 1]
+        cut = -1
+        for i in range(len(window) - 1, max(0, limit // 2), -1):
+            if window[i - 1] in _ONE_LINE_BREAK or window[i - 1].isspace():
+                cut = i
+                break
+        if cut <= 0:
+            cut = limit
+        out.append(rest[:cut].strip())
+        rest = rest[cut:].strip()
+    if rest:
+        out.append(rest)
+    return [c for c in out if c]
+
+
+def _trim_tts_silence(path: str) -> tuple[str, int]:
+    """Trim TTS edge noise and add an 80ms pure-silence pre/post roll.
+
+    TTS output can carry a low-level breath/noise at the first/last phoneme.
+    Keeping 120ms of that edge and joining clips produced an audible "嗖".
+    Here the speech is cut exactly at the first/last non-silent sample, the
+    edges get a 20ms fade, and clean digital silence (80ms) is prepended and
+    appended instead.  The 80ms pre-roll also masks the next clip's onset.
+    """
+    try:
+        audio = AudioSegment.from_file(path).set_frame_rate(48000).set_channels(2)
+        ranges = audio.detect_nonsilent(min_silence_len=100, silence_thresh=-35)
+        if not ranges:
+            return path, len(audio)
+        seg = audio[ranges[0][0]:ranges[-1][1]]
+        if len(seg) <= 60:
+            return path, len(audio)
+        seg = seg.fade_in(20).fade_out(20)
+        pad = AudioSegment.silent(duration=80, frame_rate=48000).set_channels(2)
+        seg = pad + seg + pad
+        out = Path(path).with_name(Path(path).stem + ".pre80.wav")
+        if (not out.exists()
+                or out.stat().st_mtime < Path(path).stat().st_mtime):
+            seg.export(out, format="wav")
+        return str(out), len(seg)
+    except Exception:
+        return path, 0
+
+
+def _display_items(queue: list[dict], target_lang: str) -> list[dict]:
+    """One-line display cues inside each TTS unit's final timeline."""
+    if target_lang[:2] in constants.CJK_LANG:
+        limit = int(os.environ.get("VTV_CJK_LEN", 0)
+                    or settings.get("cjk_len", 22))
+    else:
+        limit = int(settings.get("other_len", 60))
+    items: list[dict] = []
+    for it in queue:
+        chunks = _split_one_line(it.get("text", ""), max(8, limit))
+        if not chunks:
+            continue
+        start = int(it.get("start_time") or 0)
+        end = int(it.get("end_time") or start)
+        span = max(1, end - start)
+        total = sum(max(1, len(c)) for c in chunks)
+        cursor = start
+        first = len(items)
+        for chunk in chunks:
+            dur = span * len(chunk) / total
+            items.append({
+                "startraw": ms_to_time_string(ms=int(round(cursor))),
+                "endraw": ms_to_time_string(ms=int(round(cursor + dur))),
+                "text": chunk,
+            })
+            cursor += dur
+        if len(items) > first:
+            items[-1]["endraw"] = ms_to_time_string(ms=end)
+    return items
+
