+_FIT_CONTINUATIONS = (
+    "无论", "而", "但", "所以", "因为", "如果", "当", "因此", "然而", "不过",
+    "同时", "此外", "最后", "然后", "首先", "其次", "还有", "以及", "并", "且",
+    "也", "就", "则",
+)
+
+
+def _fit_join_text(first: str, second: str) -> str:
+    """Join two subtitle fragments without keeping the bridging ellipsis."""
+    a = re.sub(r"(?:\.{3}|…+)\s*$", "", (first or "").strip()).strip()
+    b = re.sub(r"^(?:\.{3}|…+)\s*", "", (second or "").strip()).strip()
+    if not a:
+        return b
+    if not b:
+        return a
+    if (not _fit_ends_sentence(a)
+            and not a.endswith(("，", ",", "、", "；", ";", "：", ":"))
+            and b.startswith(_FIT_CONTINUATIONS)):
+        return a + "，" + b
+    sep = " " if re.search(r"[A-Za-z0-9]$", a) and re.match(r"[A-Za-z0-9]", b) else ""
+    return a + sep + b
+
