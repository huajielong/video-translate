+def _fit_condense_queue(queue: list[dict], *, target_lang: str, cache_folder: str,
+                        total_ms: int, max_speed: float, pred_a: float,
+                        pred_b: float, target_speed: float) -> int:
+    """Shorten merged units that are still predicted to be spoken too fast."""
+    if not queue:
+        return 0
+    cache_path = Path(cache_folder) / "fit_condense_cache.json"
+    try:
+        cache = json.loads(cache_path.read_text(encoding="utf-8"))
+    except Exception:
+        cache = {}
