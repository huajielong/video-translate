+        if not short or _fit_chars(short) >= chars:
+            continue
+        if _fit_chars(short) > target_chars + 6:
+            logger.info(f"[fit] condense reject line {it.get('line')}: "
+                        f"{_fit_chars(short)} chars > {target_chars + 6}")
+            continue
+        if not _fit_terms_kept(text, short, terms):
+            logger.info(f"[fit] condense reject line {it.get('line')}: term lost")
+            continue
+        old_chars = chars
+        it["text"] = short
+        it["base_key"] = _fit_base_key(it, target_lang)
+        it["_fit_cached_ms"] = 0
+        changed += 1
+        logger.info(f"[fit] condense line {it.get('line')}: {old_chars} -> "
+                    f"{_fit_chars(short)} chars (slot={slot / 1000.0:.2f}s, "
+                    f"was {ratio:.2f}x)")
