+# ---------------------------------------------------------------------------
+# Dubbing-unit fitting: merge short fragments and condense over-long lines.
+#
+# The ASR/VTT segmentation is optimised for reading, not for TTS.  A 5-char
+# fragment in a 0.7 s slot still takes ~1.6 s of IndexTTS2 audio because the
+# model has a fixed per-utterance overhead, so the old per-line alignment had
+# to speed it up 2-3x.  Merging adjacent same-speaker fragments (when they are
+# contiguous) lets them share that overhead and gives the line a real slot.
+# Long lines are condensed separately when merging cannot create enough room.
+# Both steps are text/timing only; the per-line TTS cache keys are rebuilt so
+# unchanged lines still hit the cache.
+# ---------------------------------------------------------------------------
+def _fit_flag(name: str, default: bool = True) -> bool:
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    return value.strip().lower() not in ("0", "false", "no", "off", "")
+
+
+def _fit_float(name: str, default: float) -> float:
+    try:
+        return float(os.environ.get(name) or default)
+    except (TypeError, ValueError):
+        return default
+
+
+def _fit_int(name: str, default: int) -> int:
+    try:
+        return int(os.environ.get(name) or default)
+    except (TypeError, ValueError):
+        return default
+
+
+def _fit_chars(text: str) -> int:
+    return len(re.sub(r"\s", "", text or ""))
+
