+            "chars": _fit_chars(text),
+            "start": int(it.get("start_time") or 0),
+            "end": int(it.get("end_time") or 0),
+            "startraw": it.get("startraw", ""),
+            "endraw": it.get("endraw", ""),
+            "ref": (it.get("_fit_speaker")
+                    if it.get("_fit_speaker") is not None
+                    else (it.get("ref_wav") or it.get("role", ""))),
+            "role": it.get("role", ""),
+            "rate": it.get("rate", ""),
+            "volume": it.get("volume", ""),
+            "pitch": it.get("pitch", ""),
+            "tts_type": it.get("tts_type", 0),
+            "actual": int(it.get("_fit_cached_ms") or 0),
+            "fixed": bool(line_roles and str(it.get("line")) in line_roles),
+            "items": [it],
+        })
