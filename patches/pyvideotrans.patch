+def _fit_merge_queue(queue: list[dict], *, target_lang: str, max_speed: float,
+                     max_chars: int, gap_ms: int, pred_a: float, pred_b: float,
+                     line_roles: dict | None, total_ms: int,
+                     wrap_width: int = 22) -> tuple[list[dict], int]:
+    """Merge adjacent same-speaker fragments while the merged text fits.
+
+    A candidate pair is merged when at least one side is over ``max_speed``
+    and the merged unit is either under the target or clearly better than the
+    worst side.  The worst offender is merged first so a tight neighbour is
+    not stolen by a less urgent pair.
+    """
+    if len(queue) < 2:
+        return queue, 0
+
+    def pred(chars: int) -> float:
+        return pred_a + pred_b * chars
+
+    groups: list[dict] = []
+    for it in queue:
+        text = re.sub(r"\s+", " ", (it.get("text") or "")).strip()
+        groups.append({
