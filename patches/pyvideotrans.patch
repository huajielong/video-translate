+def _fit_cached_ms(item: dict, ref_cache: dict) -> int:
+    """Actual duration of this exact line if it is already in DUBBING_CACHE.
+
+    Cached audio is often more reliable than the linear predictor (short lines
+    vary by ±1s), and it lets a re-run condense the lines that were actually
+    too fast.  New/merged lines return 0 and use the predictor.
+    """
+    try:
+        ref = item.get("ref_wav") or ""
+        is_clone = str(item.get("role", "")).strip().lower() == "clone"
+        tag = _ref_tag(ref, ref_cache) if is_clone and ref else ""
+        key = get_md5(f"{item['base_key']}-ref-{tag}") if tag else item["base_key"]
+        path = Path(DUBBING_CACHE) / f"{key}.wav"
+        if not path.is_file():
+            return 0
+        try:
+            import soundfile as sf
+            return int(sf.info(str(path)).duration * 1000)
+        except Exception:
+            import wave
+            with wave.open(str(path), "rb") as w:
+                return int(w.getnframes() * 1000 / w.getframerate())
+    except Exception:
+        return 0
