+    changed = 0
+    for i, it in enumerate(queue):
+        text = it.get("text", "")
+        chars = _fit_chars(text)
+        slot = (queue[i + 1]["start_time"] if i + 1 < len(queue)
+                else (total_ms or it.get("end_time", 0))) - it.get("start_time", 0)
+        if slot <= 0:
+            continue
+        actual = int(it.get("_fit_cached_ms") or 0)
+        duration_ms = actual or (pred_a + pred_b * chars) * 1000.0
+        ratio = duration_ms / slot
