+def _fit_terms_kept(original: str, short: str,
+                    terms: list[tuple[str, list[str]]]) -> bool:
+    orig = re.sub(r"\s+", "", original or "")
+    new = re.sub(r"\s+", "", short or "")
+    for _, variants in terms:
+        if any(v in orig for v in variants) and not any(v in new for v in variants):
+            return False
+    for token in set(re.findall(r"[A-Za-z][A-Za-z0-9_+.\-/]{2,}", original or "")):
+        if token not in short:
+            return False
+    return True
