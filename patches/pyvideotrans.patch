+def _fit_clean_condense(text: str) -> str:
+    text = (text or "").strip().strip('"\'“”‘’').strip()
+    text = re.sub(r"^(?:改写|输出|结果|译文)\s*[:：]\s*", "", text)
+    text = re.sub(r"^\d+\s*[|.、:：]\s*", "", text)
+    for line in text.splitlines():
+        line = line.strip().strip('"\'“”‘’').strip()
+        if line:
+            return line
+    return ""
+
+
+def _fit_condense_text(text: str, target_chars: int, cache: dict,
+                       cache_path: Path, target_lang: str) -> str:
+    key = get_md5(f"{text}-{target_chars}-{target_lang}")
+    if key in cache and _fit_chars(cache[key]) <= target_chars + 2:
+        return cache[key]
+    api_key = os.environ.get("DEEPSEEK_API_KEY") or params.get("deepseek_key", "")
+    if not api_key:
+        return ""
+    try:
+        from openai import OpenAI
+        client = OpenAI(api_key=api_key, base_url="https://api.deepseek.com/v1/",
+                       timeout=60.0, max_retries=1)
+        model = params.get("deepseek_model") or "deepseek-flash"
+        best = ""
+        # First ask for the exact budget; if the model overshoots (common when
+        # the line contains a long technical token), retry once with a tighter
+        # budget and an explicit "must be shorter" instruction.
+        for attempt in range(2):
+            budget = target_chars if attempt == 0 else max(4, target_chars - 3)
+            low = max(4, budget - 2)
+            prompt = (
+                "你是中文配音脚本编辑。把下面这句字幕改写得能自然说完，"
+                f"尽量接近 {budget} 个汉字（不要少于 {low} 个，绝不超过 {budget} 个）。\n"
+                "要求：保留原意、数字和技术术语；删掉多余的代词、语气词、重复和客套；"
+                "不要解释，不要加引号，只输出改写后的这一句。\n"
+            )
+            if attempt:
+                prompt += "上一版仍然太长；这次必须更短，优先删修饰语和例子。\n"
+            prompt += f"\n原文：{text}"
+            resp = client.chat.completions.create(
+                model=model,
+                messages=[{"role": "user", "content": prompt}],
+                temperature=0.2,
+                max_tokens=512,
+                # deepseek-flash is a reasoning model; without this the whole
+                # budget is spent on hidden reasoning and content comes back empty.
+                extra_body={"thinking": {"type": "disabled"}},
+            )
+            out = _fit_clean_condense(resp.choices[0].message.content or "")
+            if not out:
+                continue
+            if not best or _fit_chars(out) < _fit_chars(best):
+                best = out
+            if _fit_chars(out) <= target_chars + 2:
+                break
+    except Exception as exc:  # noqa: BLE001
+        logger.warning(f"[fit] condense failed: {exc}")
+        return ""
+    out = best
+    if not out:
+        return ""
+    if _fit_chars(out) > target_chars + 2:
+        logger.warning(f"[fit] condense over target: {_fit_chars(out)} > {target_chars}")
+    cache[key] = out
+    try:
+        cache_path.write_text(json.dumps(cache, ensure_ascii=False), encoding="utf-8")
+    except Exception:
+        pass
+    return out
+
