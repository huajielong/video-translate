+        f"{item.get('rate', '+0%')}-{item.get('volume', '+0%')}-"
+        f"{item.get('pitch', '+0Hz')}-{item.get('tts_type', 0)}-"
+        f"{settings.get('remove_dubb_silence', True)}-"
+        f"{settings.get('remove_dubb_all_silence', True)}-"
+        f"{settings.get('remove_dubb_silence_level', 'default')}")
